<?xml version="1.0" encoding="utf-8"?>

<!--
    ============================================================
    Archivo: activity_main.xml

    Descripción:
    Define la interfaz gráfica principal de la aplicación Android
    del Sprint 0, con controles para buscar Elia_GTI, detener el
    escaneo y mostrar el estado de la aplicación.

    Autor: Élia Garcia Pons
    Fecha: 14/10/2026

    Copyright:
    Uso académico - Proyecto de Biometría y Medio Ambiente.

    Aportación:
    Define la disposición de los elementos visuales utilizados por
    MainActivity sin incorporar lógica de comunicación.
    ============================================================
-->

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:padding="24dp"

    tools:context=".MainActivity">


    <!-- Título de la aplicación. -->

    <TextView
        android:id="@+id/textoTitulo"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:text="Biometría - Sprint 0"
        android:textSize="24sp"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- Busca únicamente nuestro beacon Elia_GTI. -->

    <Button
        android:id="@+id/botonBuscarEliaGTI"

        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:layout_marginTop="24dp"

        android:text="Buscar Elia_GTI"

        app:layout_constraintTop_toBottomOf="@id/textoTitulo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- Detiene el escaneo Bluetooth. -->

    <Button
        android:id="@+id/botonDetenerBusqueda"

        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:layout_marginTop="16dp"

        android:text="Detener búsqueda"

        app:layout_constraintTop_toBottomOf="@id/botonBuscarEliaGTI"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- Zona en la que se muestra el estado de la aplicación. -->

    <TextView
        android:id="@+id/textoEstado"

        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:layout_marginTop="32dp"

        android:text="Esperando búsqueda..."
        android:textSize="16sp"

        app:layout_constraintTop_toBottomOf="@id/botonDetenerBusqueda"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>